# GitHub (fine-grained PAT, public repos read-only)
GITHUB_TOKEN=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Flagsmith (server-side environment key, starts with ser.)
FLAGSMITH_SERVER_KEY=
# Optional: only if a client-side SDK is used
NEXT_PUBLIC_FLAGSMITH_ENVIRONMENT_ID=
# Optional: self-hosted/local Flagsmith, e.g. http://localhost:8000/api/v1/
FLAGSMITH_API_URL=
# Optional: self-hosted events API, e.g. http://localhost:8000/api/
FLAGSMITH_EVENTS_API_URL=
# development | production (simulation refuses to run against production)
FLAGSMITH_ENV_NAME=development

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_TOKEN=
# "" in production, "sim:" for simulated traffic
TELEMETRY_PREFIX=
